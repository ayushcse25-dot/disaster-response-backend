# Copy this file to .env and replace the placeholders.
# Never commit .env or share its contents.

# Required. Local single-node replica set (see README):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
# Or MongoDB Atlas (URL-encode special characters in the username/password):
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/?appName=<app_name>

# Signs access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=<long_random_secret>
TOKEN_TTL_MINUTES=720

# Enables /api/v1/demo/* (sample data only). Keep false outside demos.
DEMO_ENABLED=false

# Optional settings
MONGODB_DB_NAME=disaster_response
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
LOG_LEVEL=INFO
ENVIRONMENT=development
